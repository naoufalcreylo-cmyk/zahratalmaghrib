{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "zahrat-almaghrib/brand",
	"title": "Logo or wordmark",
	"description": "Site logo when one is set; otherwise the temporary Arabic wordmark.",
	"icon": "admin-site",
	"attributes": {
		"variant": {
			"type": "string",
			"default": "masthead",
			"enum": [
				"masthead",
				"compact"
			]
		},
		"showTagline": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"align": false
	},
	"category": "zahrat-almaghrib",
	"textdomain": "zahrat-almaghrib",
	"editorScript": "zam-blocks-editor",
	"render": "file:./render.php"
}
