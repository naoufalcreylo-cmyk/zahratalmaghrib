{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "zahrat-almaghrib/toc",
	"title": "Table of contents",
	"description": "Shown automatically when the article has enough headings.",
	"icon": "list-view",
	"attributes": {
		"min": {
			"type": "integer",
			"default": 3
		}
	},
	"usesContext": [
		"postId",
		"postType"
	],
	"supports": {
		"html": false
	},
	"category": "zahrat-almaghrib",
	"textdomain": "zahrat-almaghrib",
	"editorScript": "zam-blocks-editor",
	"render": "file:./render.php"
}
