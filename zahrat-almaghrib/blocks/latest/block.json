{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "zahrat-almaghrib/latest",
	"title": "Latest articles",
	"description": "Latest posts with real pagination, skipping stories already shown above.",
	"icon": "grid-view",
	"attributes": {
		"title": {
			"type": "string",
			"default": ""
		},
		"excerpt": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		]
	},
	"category": "zahrat-almaghrib",
	"textdomain": "zahrat-almaghrib",
	"editorScript": "zam-blocks-editor",
	"render": "file:./render.php"
}
