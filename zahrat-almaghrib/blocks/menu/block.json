{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "zahrat-almaghrib/menu",
	"title": "Classic menu",
	"description": "Displays the menu assigned to a classic location. Hidden when no menu is assigned.",
	"icon": "menu",
	"attributes": {
		"location": {
			"type": "string",
			"default": "footer"
		},
		"label": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false
	},
	"category": "zahrat-almaghrib",
	"textdomain": "zahrat-almaghrib",
	"editorScript": "zam-blocks-editor",
	"render": "file:./render.php"
}
