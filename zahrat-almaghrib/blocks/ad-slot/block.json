{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "zahrat-almaghrib/ad-slot",
	"title": "Advertising slot",
	"description": "A labelled advertising placement with reserved space. Hidden while empty.",
	"icon": "megaphone",
	"attributes": {
		"format": {
			"type": "string",
			"default": "leaderboard",
			"enum": [
				"leaderboard",
				"rectangle",
				"inline"
			]
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		]
	},
	"category": "zahrat-almaghrib",
	"textdomain": "zahrat-almaghrib",
	"editorScript": "zam-blocks-editor",
	"render": "file:./render.php"
}
