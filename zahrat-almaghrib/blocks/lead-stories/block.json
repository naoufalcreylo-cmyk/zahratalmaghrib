{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "zahrat-almaghrib/lead-stories",
	"title": "Lead stories",
	"description": "One lead story and up to four supporting stories. Manual picks first, then sticky posts, then the latest posts.",
	"icon": "cover-image",
	"attributes": {
		"postIds": {
			"type": "array",
			"default": [],
			"items": {
				"type": "integer"
			}
		},
		"supporting": {
			"type": "integer",
			"default": 4
		},
		"useSticky": {
			"type": "boolean",
			"default": true
		},
		"category": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		]
	},
	"category": "zahrat-almaghrib",
	"textdomain": "zahrat-almaghrib",
	"editorScript": "zam-blocks-editor",
	"render": "file:./render.php"
}
