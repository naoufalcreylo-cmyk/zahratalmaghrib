{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{
					"slug": "base",
					"name": "Ivory",
					"color": "#FAF8F5"
				},
				{
					"slug": "paper",
					"name": "White",
					"color": "#FFFFFF"
				},
				{
					"slug": "sand",
					"name": "Sand",
					"color": "#F2EDE6"
				},
				{
					"slug": "line",
					"name": "Border",
					"color": "#E8E1DA"
				},
				{
					"slug": "ink",
					"name": "Charcoal",
					"color": "#202020"
				},
				{
					"slug": "ink-soft",
					"name": "Muted text",
					"color": "#6B645D"
				},
				{
					"slug": "accent",
					"name": "Burgundy",
					"color": "#8B2844"
				},
				{
					"slug": "accent-deep",
					"name": "Deep burgundy",
					"color": "#6E1D35"
				},
				{
					"slug": "gold",
					"name": "Muted gold (decorative)",
					"color": "#B69468"
				},
				{
					"slug": "gold-text",
					"name": "Gold (text-safe)",
					"color": "#7A5C34"
				},
				{
					"slug": "night",
					"name": "Night",
					"color": "#1B1A19"
				}
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1240px"
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"em",
				"%",
				"vw"
			],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "10",
					"name": "XS",
					"size": "0.375rem"
				},
				{
					"slug": "20",
					"name": "S",
					"size": "0.75rem"
				},
				{
					"slug": "30",
					"name": "M",
					"size": "clamp(1rem, 0.8rem + 0.8vw, 1.5rem)"
				},
				{
					"slug": "40",
					"name": "L",
					"size": "clamp(1.5rem, 1.1rem + 1.4vw, 2.5rem)"
				},
				{
					"slug": "50",
					"name": "XL",
					"size": "clamp(2rem, 1.3rem + 2.6vw, 4rem)"
				},
				{
					"slug": "60",
					"name": "XXL",
					"size": "clamp(3rem, 2rem + 3.6vw, 5.5rem)"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"dropCap": false,
			"fontSizes": [
				{
					"slug": "x-small",
					"name": "XS",
					"size": "0.8125rem",
					"fluid": false
				},
				{
					"slug": "small",
					"name": "S",
					"size": "0.9375rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "M",
					"size": "1.125rem",
					"fluid": {
						"min": "1.0625rem",
						"max": "1.125rem"
					}
				},
				{
					"slug": "article",
					"name": "Article body",
					"size": "1.25rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.25rem"
					}
				},
				{
					"slug": "large",
					"name": "L",
					"size": "1.5rem",
					"fluid": {
						"min": "1.25rem",
						"max": "1.5rem"
					}
				},
				{
					"slug": "x-large",
					"name": "XL",
					"size": "2rem",
					"fluid": {
						"min": "1.5rem",
						"max": "2rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "XXL",
					"size": "2.75rem",
					"fluid": {
						"min": "1.875rem",
						"max": "2.75rem"
					}
				},
				{
					"slug": "huge",
					"name": "Display",
					"size": "3.25rem",
					"fluid": {
						"min": "2.125rem",
						"max": "3.25rem"
					}
				}
			],
			"fontFamilies": [
				{
					"slug": "kufi",
					"name": "Noto Kufi Arabic (headings)",
					"fontFamily": "\"Noto Kufi Arabic\", \"Segoe UI\", Tahoma, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Noto Kufi Arabic",
							"fontWeight": "300 800",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-kufi-arabic-arabic-wght-normal.woff2"
							],
							"unicodeRange": "U+0600-06FF, U+0750-077F, U+0870-088E, U+0890-0891, U+0897-08E1, U+08E3-08FF, U+200C-200E, U+2010-2011, U+204F, U+2E41, U+FB50-FDFF, U+FE70-FE74, U+FE76-FEFC"
						},
						{
							"fontFamily": "Noto Kufi Arabic",
							"fontWeight": "300 800",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-kufi-arabic-latin-wght-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				},
				{
					"slug": "naskh",
					"name": "Noto Naskh Arabic (reading)",
					"fontFamily": "\"Noto Naskh Arabic\", \"Noto Serif\", \"Times New Roman\", serif",
					"fontFace": [
						{
							"fontFamily": "Noto Naskh Arabic",
							"fontWeight": "400 700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-naskh-arabic-arabic-wght-normal.woff2"
							],
							"unicodeRange": "U+0600-06FF, U+0750-077F, U+0870-088E, U+0890-0891, U+0897-08E1, U+08E3-08FF, U+200C-200E, U+2010-2011, U+204F, U+2E41, U+FB50-FDFF, U+FE70-FE74, U+FE76-FEFC"
						},
						{
							"fontFamily": "Noto Naskh Arabic",
							"fontWeight": "400 700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-naskh-arabic-latin-wght-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				},
				{
					"slug": "serif-latin",
					"name": "Noto Serif (French)",
					"fontFamily": "\"Noto Serif\", Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{
							"fontFamily": "Noto Serif",
							"fontWeight": "400 700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-serif-latin-wght-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Noto Serif",
							"fontWeight": "400 700",
							"fontStyle": "italic",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/noto-serif-latin-wght-italic.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				}
			]
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": false
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--ink)"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"left": "clamp(1rem, 3vw, 2rem)",
				"right": "clamp(1rem, 3vw, 2rem)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--naskh)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.85"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent-deep)"
					},
					"typography": {
						"textDecoration": "underline"
					}
				},
				":focus": {
					"typography": {
						"textDecoration": "underline"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--ink)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--kufi)",
					"fontWeight": "700",
					"lineHeight": "1.55"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"lineHeight": "1.45"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"lineHeight": "1.5"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "1.1875rem"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--paper)"
				},
				"border": {
					"radius": "2px"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--kufi)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600",
					"lineHeight": "1.6"
				},
				"spacing": {
					"padding": {
						"top": "0.6rem",
						"bottom": "0.6rem",
						"left": "1.4rem",
						"right": "1.4rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-deep)",
						"text": "var(--wp--preset--color--paper)"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--ink-soft)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--kufi)",
					"fontSize": "var(--wp--preset--font-size--x-small)",
					"lineHeight": "1.8"
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--kufi)",
					"fontSize": "0.9375rem",
					"fontWeight": "600"
				}
			},
			"core/quote": {
				"typography": {
					"fontSize": "1.375rem",
					"lineHeight": "1.9"
				}
			},
			"core/pullquote": {
				"border": {
					"top": {
						"color": "var(--wp--preset--color--gold)",
						"width": "1px",
						"style": "solid"
					},
					"bottom": {
						"color": "var(--wp--preset--color--gold)",
						"width": "1px",
						"style": "solid"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--kufi)",
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "600",
					"lineHeight": "1.7"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--line)"
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--kufi)"
				}
			},
			"core/query-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--kufi)"
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--kufi)",
					"fontWeight": "700"
				}
			},
			"core/code": {
				"typography": {
					"fontSize": "0.9375rem"
				}
			},
			"core/table": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header (sticky navigation)",
			"area": "header"
		},
		{
			"name": "header-static",
			"title": "Header (static)",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-wide",
			"title": "Wide page",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "single-plain",
			"title": "Article without table of contents",
			"postTypes": [
				"post"
			]
		}
	]
}
